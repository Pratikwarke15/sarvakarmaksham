generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  CONSUMER
  WORKER
  COOP_ADMIN
  MINISTRY_SUPER_ADMIN
}

enum WorkerStatus {
  PENDING_ADMIN_APPROVAL
  PENDING_VERIFICATION
  VERIFIED
  SUSPENDED
  DEACTIVATED
}

enum BookingStatus {
  PENDING
  ACCEPTED
  EN_ROUTE
  IN_PROGRESS
  COMPLETED
  CANCELLED
  DISPUTED
}

enum PaymentStatus {
  PENDING
  HELD_IN_ESCROW
  COMPLETED
  REFUNDED
  FAILED
}

enum TransactionType {
  PAYMENT
  COMMISSION
  PAYOUT
  DIVIDEND
  WALLET_TOPUP
  WALLET_WITHDRAWAL
  SOCIAL_SECURITY_DEDUCTION
}

enum DisputeStatus {
  OPEN
  UNDER_REVIEW
  RESOLVED
  ESCALATED
  CLOSED
}

enum DisputePriority {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum SocialSecurityFundType {
  EMERGENCY_HEALTH
  INSURANCE
  WELFARE
  EDUCATION
  RETIREMENT
}

model User {
  id            String    @id @default(uuid())
  phone         String    @unique
  email         String?   @unique
  name          String
  role          UserRole  @default(CONSUMER)
  passwordHash  String
  avatarUrl     String?
  locale        String    @default("en")
  isActive      Boolean   @default(true)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  consumerProfile  ConsumerProfile?
  workerProfile    WorkerProfile?
  coopAdminProfile CoopAdminProfile?
  bookings         Booking[]        @relation("ConsumerBookings")
  reviewsGiven     Review[]         @relation("ReviewAuthor")
  notifications    Notification[]
  fileUploads      FileUpload[]

  @@index([phone])
  @@index([role])
}

model ConsumerProfile {
  id              String   @id @default(uuid())
  userId          String   @unique
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  defaultAddress  String?
  latitude        Float?
  longitude       Float?
  savedAddresses  Json?
  phoneVerified   Boolean  @default(false)
  kycStatus       String   @default("PENDING")
  kycDocumentUrl  String?
  aadhaarNumber   String?
  aadhaarVerified Boolean  @default(false)
  aadhaarName     String?
  aadhaarDob      String?
  digilockerRef   String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([userId])
}

model WorkerProfile {
  id                String       @id @default(uuid())
  userId            String       @unique
  user              User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  coopId            String?
  coop              CoOp?        @relation(fields: [coopId], references: [id])
  status            WorkerStatus @default(PENDING_ADMIN_APPROVAL)
  skillTags         String[]
  bio               String?
  experienceYears   Int          @default(0)
  latitude          Float?
  longitude         Float?
  workAddress       String?
  isAvailable       Boolean      @default(true)
  isOnDuty          Boolean      @default(false)
  avgRating         Float        @default(0)
  totalJobs         Int          @default(0)
  totalEarnings     Decimal      @default(0) @db.Decimal(12, 2)
  walletBalance     Decimal      @default(0) @db.Decimal(12, 2)
  phoneVerified     Boolean      @default(false)
  kycStatus         String       @default("PENDING")
  kycDocumentUrl    String?
  aadhaarNumber     String?
  aadhaarVerified   Boolean      @default(false)
  aadhaarName       String?
  aadhaarDob        String?
  digilockerRef     String?
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt

  bookings          Booking[]        @relation("WorkerBookings")
  reviewsReceived   Review[]         @relation("ReviewWorker")
  walletTransactions WalletTransaction[]
  socialSecurity    SocialSecurityVault[]
  dividends         Dividend[]

  @@index([coopId])
  @@index([status])
  @@index([isAvailable, isOnDuty])
}

model CoOp {
  id              String   @id @default(uuid())
  name            String
  registrationNo  String   @unique
  description     String?
  address         String
  city            String
  state           String
  pincode         String
  latitude        Float
  longitude       Float
  radiusKm        Float    @default(10.0)
  commissionRate  Decimal  @default(5.00) @db.Decimal(5, 2)
  maxCommissionRate Decimal @default(5.00) @db.Decimal(5, 2)
  isActive        Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  admin           CoopAdminProfile?
  workers         WorkerProfile[]
  services        Service[]
  serviceAreas    CoOpServiceArea[]

  @@index([registrationNo])
  @@index([city, state])
}

model CoopAdminProfile {
  id          String  @id @default(uuid())
  userId      String  @unique
  user        User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  coopId      String  @unique
  coop        CoOp    @relation(fields: [coopId], references: [id])
  designation String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([coopId])
}

model CoOpServiceArea {
  id        String @id @default(uuid())
  coopId    String
  coop      CoOp   @relation(fields: [coopId], references: [id], onDelete: Cascade)
  areaName  String
  boundaryJson Json?
  isActive  Boolean @default(true)

  @@index([coopId])
}

model Service {
  id              String   @id @default(uuid())
  coopId          String
  coop            CoOp     @relation(fields: [coopId], references: [id])
  categoryName    String
  categorySlug    String
  name            String
  description     String?
  basePrice       Decimal  @db.Decimal(10, 2)
  unit            String   @default("fixed")
  pricePerUnit    Decimal? @db.Decimal(10, 2)
  minPrice        Decimal? @db.Decimal(10, 2)
  maxPrice        Decimal? @db.Decimal(10, 2)
  estimatedDuration Int?
  isActive        Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  bookings        Booking[]

  @@index([coopId])
  @@index([categorySlug])
  @@unique([coopId, categorySlug])
}

model Booking {
  id                String        @id @default(uuid())
  bookingRef        String        @unique
  consumerId        String
  consumer          User          @relation("ConsumerBookings", fields: [consumerId], references: [id])
  workerId          String?
  worker            WorkerProfile? @relation("WorkerBookings", fields: [workerId], references: [id])
  serviceId         String
  service           Service       @relation(fields: [serviceId], references: [id])
  status            BookingStatus @default(PENDING)
  scheduledAt       DateTime?
  startedAt         DateTime?
  completedAt       DateTime?
  consumerLatitude  Float?
  consumerLongitude Float?
  workerLatitude    Float?
  workerLongitude   Float?
  address           String
  description       String?
  quotedPrice       Decimal       @db.Decimal(10, 2)
  finalPrice        Decimal?      @db.Decimal(10, 2)
  commissionRate    Decimal       @db.Decimal(5, 2)
  commissionAmount  Decimal?      @db.Decimal(10, 2)
  workerPayout      Decimal?      @db.Decimal(10, 2)
  paymentStatus     PaymentStatus @default(PENDING)
  paymentRef        String?
  rating            Int?
  review            String?
  disputeId         String?
  cancelReason      String?
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  walletTransactions WalletTransaction[]
  disputes          Dispute[]
  reviews           Review[]

  @@index([consumerId])
  @@index([workerId])
  @@index([status])
  @@index([createdAt])
}

model WalletTransaction {
  id            String          @id @default(uuid())
  workerId      String
  worker        WorkerProfile   @relation(fields: [workerId], references: [id])
  bookingId     String?
  booking       Booking?        @relation(fields: [bookingId], references: [id])
  type          TransactionType
  amount        Decimal         @db.Decimal(12, 2)
  balanceAfter  Decimal         @db.Decimal(12, 2)
  description   String?
  reference     String?
  createdAt     DateTime        @default(now())

  @@index([workerId])
  @@index([type])
  @@index([createdAt])
}

model Dividend {
  id              String        @id @default(uuid())
  workerId        String
  worker          WorkerProfile @relation(fields: [workerId], references: [id])
  period          String
  periodStart     DateTime
  periodEnd       DateTime
  jobsCompleted   Int
  totalEarnings   Decimal       @db.Decimal(12, 2)
  patronagePoints Decimal       @db.Decimal(12, 2)
  dividendAmount  Decimal       @db.Decimal(12, 2)
  status          String        @default("PENDING")
  paidAt          DateTime?
  createdAt       DateTime      @default(now())

  @@index([workerId])
  @@index([period])
}

model SocialSecurityVault {
  id            String              @id @default(uuid())
  workerId      String
  worker        WorkerProfile       @relation(fields: [workerId], references: [id])
  fundType      SocialSecurityFundType
  totalContributed Decimal           @db.Decimal(12, 2) @default(0)
  employerMatch    Decimal           @db.Decimal(12, 2) @default(0)
  balance        Decimal             @db.Decimal(12, 2) @default(0)
  isOptedIn      Boolean             @default(false)
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt

  @@unique([workerId, fundType])
  @@index([workerId])
}

model Review {
  id          String   @id @default(uuid())
  bookingId   String
  booking     Booking  @relation(fields: [bookingId], references: [id])
  authorId    String
  author      User     @relation("ReviewAuthor", fields: [authorId], references: [id])
  workerId    String
  worker      WorkerProfile @relation("ReviewWorker", fields: [workerId], references: [id])
  rating      Int
  comment     String?
  isPublic    Boolean  @default(true)
  createdAt   DateTime @default(now())

  @@index([bookingId])
  @@index([workerId])
  @@unique([bookingId, authorId])
}

model Dispute {
  id          String         @id @default(uuid())
  bookingId   String
  booking     Booking        @relation(fields: [bookingId], references: [id])
  raisedBy    String
  status      DisputeStatus  @default(OPEN)
  priority    DisputePriority @default(MEDIUM)
  category    String
  description String
  evidence    Json?
  resolution  String?
  resolvedBy  String?
  resolvedAt  DateTime?
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  @@index([bookingId])
  @@index([status])
}

model OtpVerification {
  id        String   @id @default(uuid())
  phone     String?
  email     String?
  otp       String
  purpose   String   @default("LOGIN")
  expiresAt DateTime
  verified  Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([phone, purpose])
  @@index([email, purpose])
}

model ServiceCategory {
  id          String  @id @default(uuid())
  name        String  @unique
  slug        String  @unique
  icon        String?
  description String?
  isActive    Boolean @default(true)
  sortOrder   Int     @default(0)
}

model Notification {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String
  message   String
  type      String   @default("SYSTEM")
  read      Boolean  @default(false)
  data      Json?
  createdAt DateTime @default(now())

  @@index([userId, read])
  @@index([createdAt])
}

model FileUpload {
  id           String   @id @default(uuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  fileName     String
  originalName String
  mimeType     String
  size         Int
  url          String
  bucket       String
  purpose      String
  createdAt    DateTime @default(now())

  @@index([userId])
  @@index([purpose])
}
