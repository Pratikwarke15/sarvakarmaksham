generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  CONSUMER
  WORKER
  COOP_ADMIN
  MINISTRY_SUPER_ADMIN
}

enum WorkerDutyState {
  OFF_DUTY
  AVAILABLE
  REQUEST_RECEIVED
  ACCEPTED
  TRAVELLING
  ARRIVED
  WORKING
  COMPLETED
  BUSY
  ON_JOB
}

enum WorkerStatus {
  PENDING_ADMIN_APPROVAL
  PENDING_VERIFICATION
  VERIFIED
  SUSPENDED
  DEACTIVATED
}

enum BookingStatus {
  PENDING
  ACCEPTED
  EN_ROUTE
  IN_PROGRESS
  COMPLETED
  CANCELLED
  DISPUTED
}

enum PaymentStatus {
  PENDING
  HELD_IN_ESCROW
  COMPLETED
  REFUNDED
  FAILED
}

enum OrderPaymentStatus {
  NOT_DUE
  PAYMENT_PENDING
  PAYMENT_PROCESSING
  PAID
  PAYMENT_FAILED
  REFUNDED
}

enum OrderStatus {
  DRAFT
  REQUESTED
  ACCEPTED
  REJECTED
  NEGOTIATION
  CONFIRMED
  TRAVELLING
  ARRIVED
  IN_PROGRESS
  COMPLETED
  CANCELLED
  PAYMENT_PENDING
  PAID
}

enum BookingMode {
  IMMEDIATE
  SCHEDULED
}

enum ProposalParty {
  WORKER
  CONSUMER
}

enum ProposalStatus {
  PENDING
  ACCEPTED
  REJECTED
  COUNTERED
}

enum TransactionType {
  PAYMENT
  COMMISSION
  PAYOUT
  DIVIDEND
  WALLET_TOPUP
  WALLET_WITHDRAWAL
  SOCIAL_SECURITY_DEDUCTION
}

enum DisputeStatus {
  OPEN
  UNDER_REVIEW
  RESOLVED
  ESCALATED
  CLOSED
}

enum DisputePriority {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum SocialSecurityFundType {
  EMERGENCY_HEALTH
  INSURANCE
  WELFARE
  EDUCATION
  RETIREMENT
}

model User {
  id            String    @id @default(uuid())
  phone         String    @unique
  email         String?   @unique
  name          String
  role          UserRole  @default(CONSUMER)
  passwordHash  String
  avatarUrl     String?
  locale        String    @default("en")
  isActive      Boolean   @default(true)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  consumerProfile  ConsumerProfile?
  workerProfile    WorkerProfile?
  coopAdminProfile CoopAdminProfile?
  bookings         Booking[]        @relation("ConsumerBookings")
  reviewsGiven     Review[]         @relation("ReviewAuthor")
  notifications    Notification[]
  fileUploads      FileUpload[]
  problemRequests  ProblemRequest[] @relation("ConsumerProblemRequests")
  ordersAsConsumer Order[]          @relation("ConsumerOrders")

  @@index([phone])
  @@index([role])
}

model ConsumerProfile {
  id              String   @id @default(uuid())
  userId          String   @unique
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  defaultAddress  String?
  latitude        Float?
  longitude       Float?
  savedAddresses  Json?
  phoneVerified   Boolean  @default(false)
  kycStatus       String   @default("PENDING")
  kycDocumentUrl  String?
  aadhaarNumber   String?
  aadhaarVerified Boolean  @default(false)
  aadhaarName     String?
  aadhaarDob      String?
  digilockerRef   String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([userId])
}

model WorkerProfile {
  id                String       @id @default(uuid())
  userId            String       @unique
  user              User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  coopId            String?
  coop              CoOp?        @relation(fields: [coopId], references: [id])
  status            WorkerStatus @default(PENDING_ADMIN_APPROVAL)
  skillTags         String[]
  bio               String?
  experienceYears   Int          @default(0)
  latitude          Float?
  longitude         Float?
  workAddress       String?
  isAvailable       Boolean      @default(true)
  isOnDuty          Boolean      @default(false)
  dutyState         WorkerDutyState @default(OFF_DUTY)
  avgRating         Float        @default(0)
  totalJobs         Int          @default(0)
  totalEarnings     Decimal      @default(0) @db.Decimal(12, 2)
  walletBalance     Decimal      @default(0) @db.Decimal(12, 2)
  phoneVerified     Boolean      @default(false)
  kycStatus         String       @default("PENDING")
  kycDocumentUrl    String?
  aadhaarNumber     String?
  aadhaarVerified   Boolean      @default(false)
  aadhaarName       String?
  aadhaarDob        String?
  digilockerRef     String?
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt

  bookings          Booking[]        @relation("WorkerBookings")
  reviewsReceived   Review[]         @relation("ReviewWorker")
  walletTransactions WalletTransaction[]
  socialSecurity    SocialSecurityVault[]
  dividends         Dividend[]
  quotes            WorkerQuote[]
  orders            Order[]          @relation("WorkerOrders")

  @@index([coopId])
  @@index([status])
  @@index([isAvailable, isOnDuty])
}

model CoOp {
  id              String   @id @default(uuid())
  name            String
  registrationNo  String   @unique
  description     String?
  address         String
  city            String
  state           String
  pincode         String
  latitude        Float
  longitude       Float
  radiusKm        Float    @default(10.0)
  commissionRate  Decimal  @default(5.00) @db.Decimal(5, 2)
  maxCommissionRate Decimal @default(5.00) @db.Decimal(5, 2)
  isActive        Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  admin           CoopAdminProfile?
  workers         WorkerProfile[]
  services        Service[]
  serviceAreas    CoOpServiceArea[]

  @@index([registrationNo])
  @@index([city, state])
}

model CoopAdminProfile {
  id          String  @id @default(uuid())
  userId      String  @unique
  user        User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  coopId      String  @unique
  coop        CoOp    @relation(fields: [coopId], references: [id])
  designation String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([coopId])
}

model CoOpServiceArea {
  id        String @id @default(uuid())
  coopId    String
  coop      CoOp   @relation(fields: [coopId], references: [id], onDelete: Cascade)
  areaName  String
  boundaryJson Json?
  isActive  Boolean @default(true)

  @@index([coopId])
}

model Service {
  id              String   @id @default(uuid())
  coopId          String
  coop            CoOp     @relation(fields: [coopId], references: [id])
  categoryName    String
  categorySlug    String
  name            String
  description     String?
  basePrice       Decimal  @db.Decimal(10, 2)
  unit            String   @default("fixed")
  pricePerUnit    Decimal? @db.Decimal(10, 2)
  minPrice        Decimal? @db.Decimal(10, 2)
  maxPrice        Decimal? @db.Decimal(10, 2)
  estimatedDuration Int?
  isActive        Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  bookings        Booking[]

  @@index([coopId])
  @@index([categorySlug])
  @@unique([coopId, categorySlug])
}

model Booking {
  id                String        @id @default(uuid())
  bookingRef        String        @unique
  consumerId        String
  consumer          User          @relation("ConsumerBookings", fields: [consumerId], references: [id])
  workerId          String?
  worker            WorkerProfile? @relation("WorkerBookings", fields: [workerId], references: [id])
  serviceId         String
  service           Service       @relation(fields: [serviceId], references: [id])
  status            BookingStatus @default(PENDING)
  scheduledAt       DateTime?
  startedAt         DateTime?
  completedAt       DateTime?
  consumerLatitude  Float?
  consumerLongitude Float?
  workerLatitude    Float?
  workerLongitude   Float?
  address           String
  description       String?
  quotedPrice       Decimal       @db.Decimal(10, 2)
  finalPrice        Decimal?      @db.Decimal(10, 2)
  commissionRate    Decimal       @db.Decimal(5, 2)
  commissionAmount  Decimal?      @db.Decimal(10, 2)
  workerPayout      Decimal?      @db.Decimal(10, 2)
  paymentStatus     PaymentStatus @default(PENDING)
  paymentRef        String?
  rating            Int?
  review            String?
  disputeId         String?
  cancelReason      String?
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  walletTransactions WalletTransaction[]
  disputes          Dispute[]
  reviews           Review[]

  @@index([consumerId])
  @@index([workerId])
  @@index([status])
  @@index([createdAt])
}

model WalletTransaction {
  id            String          @id @default(uuid())
  workerId      String
  worker        WorkerProfile   @relation(fields: [workerId], references: [id])
  bookingId     String?
  booking       Booking?        @relation(fields: [bookingId], references: [id])
  orderId       String?
  order         Order?          @relation(fields: [orderId], references: [id])
  type          TransactionType
  amount        Decimal         @db.Decimal(12, 2)
  balanceAfter  Decimal         @db.Decimal(12, 2)
  description   String?
  reference     String?
  createdAt     DateTime        @default(now())

  @@index([workerId])
  @@index([orderId])
  @@index([type])
  @@index([createdAt])
}

model Dividend {
  id              String        @id @default(uuid())
  workerId        String
  worker          WorkerProfile @relation(fields: [workerId], references: [id])
  period          String
  periodStart     DateTime
  periodEnd       DateTime
  jobsCompleted   Int
  totalEarnings   Decimal       @db.Decimal(12, 2)
  patronagePoints Decimal       @db.Decimal(12, 2)
  dividendAmount  Decimal       @db.Decimal(12, 2)
  status          String        @default("PENDING")
  paidAt          DateTime?
  createdAt       DateTime      @default(now())

  @@index([workerId])
  @@index([period])
}

model SocialSecurityVault {
  id            String              @id @default(uuid())
  workerId      String
  worker        WorkerProfile       @relation(fields: [workerId], references: [id])
  fundType      SocialSecurityFundType
  totalContributed Decimal           @db.Decimal(12, 2) @default(0)
  employerMatch    Decimal           @db.Decimal(12, 2) @default(0)
  balance        Decimal             @db.Decimal(12, 2) @default(0)
  isOptedIn      Boolean             @default(false)
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt

  @@unique([workerId, fundType])
  @@index([workerId])
}

model Review {
  id          String   @id @default(uuid())
  bookingId   String
  booking     Booking  @relation(fields: [bookingId], references: [id])
  authorId    String
  author      User     @relation("ReviewAuthor", fields: [authorId], references: [id])
  workerId    String
  worker      WorkerProfile @relation("ReviewWorker", fields: [workerId], references: [id])
  rating      Int
  comment     String?
  isPublic    Boolean  @default(true)
  createdAt   DateTime @default(now())

  @@index([bookingId])
  @@index([workerId])
  @@unique([bookingId, authorId])
}

model Dispute {
  id          String         @id @default(uuid())
  bookingId   String
  booking     Booking        @relation(fields: [bookingId], references: [id])
  raisedBy    String
  status      DisputeStatus  @default(OPEN)
  priority    DisputePriority @default(MEDIUM)
  category    String
  description String
  evidence    Json?
  resolution  String?
  resolvedBy  String?
  resolvedAt  DateTime?
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  @@index([bookingId])
  @@index([status])
}

model OtpVerification {
  id        String   @id @default(uuid())
  phone     String?
  email     String?
  otp       String
  purpose   String   @default("LOGIN")
  expiresAt DateTime
  verified  Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([phone, purpose])
  @@index([email, purpose])
}

enum ProblemRequestStatus {
  DRAFT
  SUBMITTED
  CANCELLED
}

model ServiceCategory {
  id          String   @id @default(uuid())
  slug        String   @unique
  name        String   @unique
  hindiName   String?
  icon        String?
  description String?
  active      Boolean  @default(true) @map("isActive")
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @default(now()) @updatedAt

  subcategories   ServiceSubCategory[]
  problems        ServiceProblem[]
  problemRequests ProblemRequest[]
  orders          Order[]

  @@index([slug])
  @@index([active])
}

model ServiceSubCategory {
  id          String          @id @default(uuid())
  categoryId  String
  category    ServiceCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  slug        String
  name        String
  hindiName   String?
  icon        String?
  description String?
  active      Boolean         @default(true)
  sortOrder   Int             @default(0)
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @default(now()) @updatedAt

  problems        ServiceProblem[]
  problemRequests ProblemRequest[]
  orders          Order[]

  @@unique([categoryId, slug])
  @@index([categoryId])
  @@index([active])
}

model ServiceProblem {
  id                 String             @id @default(uuid())
  categoryId         String
  category           ServiceCategory    @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  subcategoryId      String
  subcategory        ServiceSubCategory @relation(fields: [subcategoryId], references: [id], onDelete: Cascade)
  name               String
  hindiName          String?
  description        String?
  estimatedDuration  Int                @default(60) // in minutes
  basePrice          Decimal            @db.Decimal(10, 2)
  minimumPrice       Decimal            @db.Decimal(10, 2)
  maximumPrice       Decimal            @db.Decimal(10, 2)
  workerPriceCeiling Decimal            @db.Decimal(10, 2)
  pricingUnit        String             @default("per_job")
  labourCostMin      Decimal            @default(99.00) @db.Decimal(10, 2)
  labourCostMax      Decimal            @default(199.00) @db.Decimal(10, 2)
  inspectionFee      Decimal            @default(99.00) @db.Decimal(10, 2)
  platformFeeRate    Decimal            @default(5.00) @db.Decimal(5, 2)
  materialCostMin    Decimal            @default(0.00) @db.Decimal(10, 2)
  materialCostMax    Decimal            @default(0.00) @db.Decimal(10, 2)
  materialNote       String             @default("Additional material cost may apply after inspection.")
  benchmarkSource    String             @default("CPWD DSR 2023 & Indian Urban Gig Benchmarks")
  active             Boolean            @default(true)
  sortOrder          Int                @default(0)
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @default(now()) @updatedAt

  problemRequests    ProblemRequest[]
  pricingConfigs     ProblemPricingConfig[]
  quotes             WorkerQuote[]
  orders             Order[]

  @@index([categoryId])
  @@index([subcategoryId])
  @@index([active])
}

model ProblemRequest {
  id                 String               @id @default(uuid())
  requestRef         String               @unique // e.g. "PR-123456"
  consumerId         String
  consumer           User                 @relation("ConsumerProblemRequests", fields: [consumerId], references: [id], onDelete: Cascade)
  categoryId         String
  category           ServiceCategory      @relation(fields: [categoryId], references: [id])
  subcategoryId      String
  subcategory        ServiceSubCategory   @relation(fields: [subcategoryId], references: [id])
  problemId          String
  problem            ServiceProblem       @relation(fields: [problemId], references: [id])
  
  // Explanation: text OR audio mandatory
  textDescription    String?
  audioUrl           String?
  audioDuration      Int?                 // in seconds
  
  // Optional attachments
  photos             String[]             @default([])
  videoUrl           String?
  additionalNotes    String?

  // Location information if available
  address            String?
  latitude           Float?
  longitude          Float?

  // Estimate snapshot from selected problem
  estimatedPriceMin  Decimal              @db.Decimal(10, 2)
  estimatedPriceMax  Decimal              @db.Decimal(10, 2)
  estimatedDuration  Int                  @default(60)
  pricingUnit        String?              @default("per_job")
  labourCostMin      Decimal?             @db.Decimal(10, 2)
  labourCostMax      Decimal?             @db.Decimal(10, 2)
  inspectionFee      Decimal?             @db.Decimal(10, 2)
  platformFeeRate    Decimal?             @db.Decimal(5, 2)
  materialNote       String?
  workerPriceCeiling Decimal?             @db.Decimal(10, 2)
  selectedWorkerId   String?

  quotes             WorkerQuote[]
  orders             Order[]

  status             ProblemRequestStatus @default(DRAFT)
  createdAt          DateTime             @default(now())
  updatedAt          DateTime             @default(now()) @updatedAt

  @@index([consumerId])
  @@index([status])
  @@index([categoryId])
}

model Notification {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String
  message   String
  type      String   @default("SYSTEM")
  read      Boolean  @default(false)
  data      Json?
  createdAt DateTime @default(now())

  @@index([userId, read])
  @@index([createdAt])
}

model FileUpload {
  id           String   @id @default(uuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  fileName     String
  originalName String
  mimeType     String
  size         Int
  url          String
  bucket       String
  purpose      String
  createdAt    DateTime @default(now())

  @@index([userId])
  @@index([purpose])
}

model ProblemPricingConfig {
  id                 String         @id @default(uuid())
  problemId          String
  problem            ServiceProblem @relation(fields: [problemId], references: [id], onDelete: Cascade)
  city               String?        // null for national/default, or "DELHI", "MUMBAI", "BENGALURU"
  skillLevel         String?        // null for standard, or "APPRENTICE", "SKILLED", "MASTER"
  basePrice          Decimal        @db.Decimal(10, 2)
  minimumPrice       Decimal        @db.Decimal(10, 2)
  maximumPrice       Decimal        @db.Decimal(10, 2)
  workerPriceCeiling Decimal        @db.Decimal(10, 2)
  labourCostMin      Decimal        @db.Decimal(10, 2)
  labourCostMax      Decimal        @db.Decimal(10, 2)
  inspectionFee      Decimal        @default(99.00) @db.Decimal(10, 2)
  platformFeeRate    Decimal        @default(5.00) @db.Decimal(5, 2)
  materialNote       String         @default("Additional material cost may apply after inspection.")
  benchmarkSource    String?
  isActive           Boolean        @default(true)
  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @default(now()) @updatedAt

  @@unique([problemId, city, skillLevel])
  @@index([problemId])
  @@index([city])
}

model WorkerQuote {
  id                   String         @id @default(uuid())
  problemRequestId     String
  problemRequest       ProblemRequest @relation(fields: [problemRequestId], references: [id], onDelete: Cascade)
  problemId            String?
  problem              ServiceProblem? @relation(fields: [problemId], references: [id])
  workerId             String
  worker               WorkerProfile  @relation(fields: [workerId], references: [id], onDelete: Cascade)
  quotedAmount         Decimal        @db.Decimal(10, 2)
  labourAmount         Decimal        @db.Decimal(10, 2)
  materialAmount       Decimal        @default(0.00) @db.Decimal(10, 2)
  notes                String?
  hasAdditionalWork    Boolean        @default(false)
  additionalWorkReason String?
  status               String         @default("PENDING") // PENDING, ACCEPTED, REJECTED, EXPIRED
  createdAt            DateTime       @default(now())
  updatedAt            DateTime       @default(now()) @updatedAt

  @@index([problemRequestId])
  @@index([workerId])
}

model Order {
  id                 String           @id @default(uuid())
  orderRef           String           @unique // e.g. "ORD-261001-XXXX"
  consumerId         String
  consumer           User             @relation("ConsumerOrders", fields: [consumerId], references: [id], onDelete: Cascade)
  workerId           String?
  worker             WorkerProfile?   @relation("WorkerOrders", fields: [workerId], references: [id])
  problemRequestId   String?
  problemRequest     ProblemRequest?  @relation(fields: [problemRequestId], references: [id])
  categoryId         String
  category           ServiceCategory  @relation(fields: [categoryId], references: [id])
  subcategoryId      String
  subcategory        ServiceSubCategory @relation(fields: [subcategoryId], references: [id])
  problemId          String
  problem            ServiceProblem   @relation(fields: [problemId], references: [id])
  
  status             OrderStatus      @default(REQUESTED)
  bookingMode        BookingMode      @default(IMMEDIATE)
  scheduledAt        DateTime?

  // Location & Privacy
  address            String           // Full consumer address (private before acceptance)
  latitude           Float?
  longitude          Float?
  approxDistanceKm   Float?           // Approximate distance for worker before acceptance
  approxArea         String?          // e.g. "Near Saket / South Delhi"

  // Problem Snapshot
  problemTitle       String
  textDescription    String?
  audioUrl           String?
  audioDuration      Int?
  photos             String[]         @default([])
  videoUrl           String?
  additionalNotes    String?

  // Price Snapshot Grounded in Researched Estimates
  basePrice          Decimal          @db.Decimal(10, 2)
  estimatedPriceMin  Decimal          @db.Decimal(10, 2)
  estimatedPriceMax  Decimal          @db.Decimal(10, 2)
  workerPriceCeiling Decimal          @db.Decimal(10, 2)
  quotedPrice        Decimal?         @db.Decimal(10, 2)
  finalPrice         Decimal?         @db.Decimal(10, 2)

  // Price Negotiation & Locking
  isPriceLocked      Boolean          @default(false)
  priceConfirmedAt   DateTime?
  priceConfirmedById String?
  negotiationConsent Boolean          @default(true)

  // In-PWA Voice Communication Consent & Calls (Phase 7)
  communicationConsent   Boolean          @default(false)
  consumerConsentGranted Boolean          @default(false)
  workerConsentGranted   Boolean          @default(false)
  communicationConsentAt DateTime?

  calls                  CallSession[]

  priceProposals     OrderPriceProposal[] @relation("OrderPriceProposals")

  // Rejection handling
  rejectionReason    String?          // e.g. "Too far", "Not available", "Outside my skill", "Price not suitable", "Other"
  rejectionCustomNote String?
  rejectedAt         DateTime?
  acceptedAt         DateTime?
  cancelledAt        DateTime?
  completedAt        DateTime?

  // Post-Completion Payment & Earnings (Phase 8)
  paymentStatus        OrderPaymentStatus   @default(NOT_DUE)
  grossAmount          Decimal?             @db.Decimal(10, 2)
  platformFee          Decimal              @default(0) @db.Decimal(10, 2)
  workerEarnings       Decimal?             @db.Decimal(10, 2)
  taxAmount            Decimal              @default(0) @db.Decimal(10, 2)
  otherDeductions      Decimal              @default(0) @db.Decimal(10, 2)
  workCompletedAt      DateTime?
  paymentCompletedAt   DateTime?
  paymentMethod        String?
  razorpayOrderId      String?
  razorpayPaymentId    String?
  razorpaySignature    String?

  payments             OrderPayment[]
  walletTransactions   WalletTransaction[]

  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt

  statusHistory      OrderStatusHistory[]

  @@index([consumerId])
  @@index([workerId])
  @@index([status])
  @@index([paymentStatus])
  @@index([bookingMode])
  @@index([createdAt])
}

model OrderPayment {
  id                String             @id @default(uuid())
  orderId           String
  order             Order              @relation(fields: [orderId], references: [id], onDelete: Cascade)
  paymentRef        String             @unique
  razorpayOrderId   String?
  razorpayPaymentId String?
  amount            Decimal            @db.Decimal(10, 2)
  grossAmount       Decimal            @db.Decimal(10, 2)
  platformFee       Decimal            @default(0) @db.Decimal(10, 2)
  workerEarnings    Decimal            @db.Decimal(10, 2)
  taxAmount         Decimal            @default(0) @db.Decimal(10, 2)
  status            OrderPaymentStatus @default(PAYMENT_PENDING)
  paymentMethod     String             @default("RAZORPAY")
  failureReason     String?
  paidAt            DateTime?
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt

  @@index([orderId])
  @@index([razorpayOrderId])
  @@index([razorpayPaymentId])
}

model OrderStatusHistory {
  id         String      @id @default(uuid())
  orderId    String
  order      Order       @relation(fields: [orderId], references: [id], onDelete: Cascade)
  fromStatus OrderStatus
  toStatus   OrderStatus
  changedById String?
  reason     String?
  createdAt  DateTime    @default(now())

  @@index([orderId])
}

model OrderPriceProposal {
  id           String         @id @default(uuid())
  orderId      String
  order        Order          @relation("OrderPriceProposals", fields: [orderId], references: [id], onDelete: Cascade)
  proposerRole ProposalParty
  proposerId   String
  amount       Decimal        @db.Decimal(10, 2)
  reason       String?
  status       ProposalStatus @default(PENDING)
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  @@index([orderId])
  @@index([status])
}

enum CallStatus {
  RINGING
  CONNECTED
  REJECTED
  MISSED
  ENDED
  FAILED
}

model CallSession {
  id          String     @id @default(uuid())
  orderId     String
  order       Order      @relation(fields: [orderId], references: [id], onDelete: Cascade)
  callerId    String
  receiverId  String
  callerRole  String     // "CONSUMER" | "WORKER"
  status      CallStatus @default(RINGING)
  startedAt   DateTime?
  endedAt     DateTime?
  durationSec Int        @default(0)
  endReason   String?    // "normal", "declined", "timeout", "network_error"
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  @@index([orderId])
  @@index([callerId])
  @@index([receiverId])
}

